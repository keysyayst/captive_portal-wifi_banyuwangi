##
## mods-available/sql -- FreeRADIUS SQL module config
## Menggunakan MySQL backend (tabel standar rlm_sql)
##

sql {
    # sql_username - variabel yang digunakan dalam queries untuk USER-NAME
    # Ini digunakan oleh rlm_sql untuk menentukan username dari request RADIUS
    sql_username = "%{User-Name}"

    dialect = "mysql"
    driver = "rlm_sql_mysql"

    ## Koneksi ke MySQL (sama dengan Laravel DB)
    server  = $ENV{RADIUS_DB_HOST}
    port    = $ENV{RADIUS_DB_PORT}
    login   = $ENV{RADIUS_DB_USER}
    password = $ENV{RADIUS_DB_PASS}

    ## Nama database yang dipakai
    radius_db = $ENV{RADIUS_DB_NAME}

    ## Opsi koneksi
    acct_table1 = "radacct"
    acct_table2 = "radacct"
    postauth_table = "radpostauth"
    authcheck_table = "radcheck"
    groupcheck_table = "radgroupcheck"
    authreply_table = "radreply"
    groupreply_table = "radgroupreply"
    usergroup_table = "radusergroup"

    ## Hapus session lama saat CoA/Disconnect? (yes/no)
    delete_stale_sessions = yes

    ## Tambahkan info NAS ke accounting
    nas_table = "nas"

    ## Gunakan group queries
    read_groups = yes
    read_profiles = yes

    ## Pool koneksi
    pool {
        start = 5
        min = 4
        max = 32
        spare = 10
        uses = 0
        retry_delay = 30
        lifetime = 0
        idle_timeout = 60
    }

    ## MySQL TLS (nonaktifkan untuk dev lokal)
    mysql {
        tls {
        }
        warnings = auto
    }

    ## Query untuk ambil password user
    ## Username di sini adalah nomor HP
    authorize_check_query = "SELECT id, username, attribute, value, op \
        FROM ${authcheck_table} \
        WHERE username = '%{User-Name}' \
        ORDER BY id"

    authorize_group_check_query = "SELECT id, groupname, attribute, \
        value, op \
        FROM ${groupcheck_table} \
        WHERE groupname = '%{Sql-Group}' \
        ORDER BY id"

    authorize_reply_query = "SELECT id, username, attribute, value, op \
        FROM ${authreply_table} \
        WHERE username = '%{User-Name}' \
        ORDER BY id"

    authorize_group_reply_query = "SELECT id, groupname, attribute, value, op \
        FROM ${groupreply_table} \
        WHERE groupname = '%{Sql-Group}' \
        ORDER BY id"

    group_membership_query = "SELECT groupname FROM ${usergroup_table} \
        WHERE username = '%{User-Name}' \
        ORDER BY priority"

    simul_count_query = "SELECT COUNT(*) \
        FROM ${acct_table1} \
        WHERE username = '%{User-Name}' \
        AND acctstoptime IS NULL"

    simul_verify_query = "SELECT radacctid, acctsessionid, username, nasipaddress, \
        nasportid, framedipaddress, callingstationid, framedprotocol \
        FROM ${acct_table1} \
        WHERE username = '%{User-Name}' \
        AND acctstoptime IS NULL"

    ## Accounting queries
    accounting_onoff_query = "UPDATE ${acct_table1} \
        SET acctstoptime = FROM_UNIXTIME('%{integer:Event-Timestamp}'), \
        acctsessiontime = '%{integer:Event-Timestamp}' - UNIX_TIMESTAMP(acctstarttime), \
        acctterminatecause = '%{Acct-Terminate-Cause}', \
        acctstopdelay = '%{Acct-Delay-Time:-0}' \
        WHERE acctstoptime IS NULL \
        AND nasipaddress = '%{NAS-IP-Address}' \
        AND acctstarttime <= FROM_UNIXTIME('%{integer:Event-Timestamp}')"

    accounting_update_query = "UPDATE ${acct_table1} \
        SET framedipaddress = '%{Framed-IP-Address}', \
        acctsessiontime = '%{Acct-Session-Time}', \
        acctinputoctets = '%{Acct-Input-Gigawords:-0}' * 4294967296 + '%{Acct-Input-Octets:-0}', \
        acctoutputoctets = '%{Acct-Output-Gigawords:-0}' * 4294967296 + '%{Acct-Output-Octets:-0}' \
        WHERE acctsessionid = '%{Acct-Session-Id}' \
        AND username = '%{User-Name}' \
        AND nasipaddress = '%{NAS-IP-Address}'"

    accounting_start_query = "INSERT INTO ${acct_table1} \
        (acctsessionid, acctuniqueid, username, realm, nasipaddress, nasportid, \
        nasporttype, acctstarttime, acctstartdelay, callingstationid, \
        calledstationid, servicetype, framedprotocol, framedipaddress) \
        VALUES('%{Acct-Session-Id}', '%{Acct-Unique-Session-Id}', \
        '%{User-Name}', '%{Realm}', '%{NAS-IP-Address}', \
        '%{NAS-Port}', '%{NAS-Port-Type}', \
        FROM_UNIXTIME('%{integer:Event-Timestamp}'), \
        '%{Acct-Delay-Time:-0}', '%{Calling-Station-Id}', \
        '%{Called-Station-Id}', '%{Service-Type}', \
        '%{Framed-Protocol}', '%{Framed-IP-Address}')"

    accounting_stop_query = "UPDATE ${acct_table1} \
        SET acctstoptime = FROM_UNIXTIME('%{integer:Event-Timestamp}'), \
        acctsessiontime = '%{Acct-Session-Time}', \
        acctinputoctets = '%{Acct-Input-Gigawords:-0}' * 4294967296 + '%{Acct-Input-Octets:-0}', \
        acctoutputoctets = '%{Acct-Output-Gigawords:-0}' * 4294967296 + '%{Acct-Output-Octets:-0}', \
        acctterminatecause = '%{Acct-Terminate-Cause}', \
        acctstopdelay = '%{Acct-Delay-Time:-0}', \
        framedipaddress = '%{Framed-IP-Address}' \
        WHERE acctsessionid = '%{Acct-Session-Id}' \
        AND username = '%{User-Name}' \
        AND nasipaddress = '%{NAS-IP-Address}'"

    ## Post-auth logging - log authentication attempts
    postauth_query = "INSERT INTO ${postauth_table} \
        (username, pass, reply, authdate) \
        VALUES (TRUNCATE('%{User-Name}', 64), TRUNCATE('%{User-Password:-Chap-Password}', 64), \
        '%{reply:Packet-Type}', NOW())"

    ## Accounting Start query
    start_query = "${accounting_start_query}"

    ## Accounting Stop query  
    stop_query = "${accounting_stop_query}"

    ## Accounting Update query
    interim_update_query = "${accounting_update_query}"
}
